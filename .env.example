# Set DATABASE_URL through Replit Secrets. Never commit a real connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Keep SESSION_SECRET in Replit Secrets, not in this file.
# Use a random value with at least 32 bytes; it derives the JWT signing keys.

# Optional; defaults to 5000 for the Replit preview.
PORT=5000
